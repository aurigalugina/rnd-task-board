DATABASE_URL=postgres://rndops:rndops@postgres:5432/rndops?sslmode=disable
JWT_SECRET=change-me-in-production
PORT=8080
# APP_ENV=production mengaktifkan flag Secure pada refresh token cookie (butuh HTTPS).
# Biarkan kosong/unset untuk development lokal (http://localhost).
APP_ENV=
# Origin tambahan yang diizinkan CORS (koma-separated). Tambah staging domain di sini
# kalau app di-akses via proxy staging → dev server (jalur VPN). Contoh:
# ALLOWED_ORIGINS=https://staging.rndops.internal,http://192.168.1.50:8080
ALLOWED_ORIGINS=
# Direktori penyimpanan file upload (Cheat Sheet tipe file) — lihat
# docs/decision-log/decision-log-file-upload-storage-20260809.md.
UPLOAD_DIR=/app/uploads
# claude-chat-service (Vision §6, Change Request) — diproksikan backend lewat
# /api/v1/chat/*. Kosong = fitur chat 502 (graceful), fitur lain tetap normal.
CLAUDE_CHAT_SERVICE_URL=http://host.docker.internal:8091
# Direktori project yang OTOMATIS dipakai tiap sesi Change Request — di-set
# sekali di sini, user TIDAK perlu memilih di UI (Vision §6). Path ini adalah
# path di host tempat claude-chat-service berjalan & membaca repo.
CHAT_DEFAULT_CWD=/opt/rnd-task-board
