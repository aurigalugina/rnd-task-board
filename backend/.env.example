DATABASE_URL=postgres://rndops:rndops@postgres:5432/rndops?sslmode=disable
JWT_SECRET=change-me-in-production
PORT=8080
# APP_ENV=production mengaktifkan flag Secure pada refresh token cookie (butuh HTTPS).
# Biarkan kosong/unset untuk development lokal (http://localhost).
APP_ENV=
# Direktori penyimpanan file upload (Cheat Sheet tipe file) — lihat
# docs/decision-log/decision-log-file-upload-storage-20260809.md.
UPLOAD_DIR=/app/uploads
