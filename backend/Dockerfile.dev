FROM golang:1.25-alpine
WORKDIR /app
RUN apk add --no-cache git
# air@latest kadang butuh toolchain Go lebih baru dari base image ini --
# GOTOOLCHAIN=auto biar go install otomatis download toolchain yang sesuai
# cuma buat build air, tidak mempengaruhi go.mod project (tetap go 1.22).
ENV GOTOOLCHAIN=auto
RUN go install github.com/air-verse/air@latest
COPY go.mod go.sum ./
RUN go mod download
COPY . .
EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
