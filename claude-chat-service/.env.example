# Salin file ini ke .env dan isi nilainya sebelum `docker compose up`.

# Port service (default 8091 — harus cocok dengan CLAUDE_CHAT_SERVICE_URL di backend .env)
PORT=8091

# Path direktori project di server — harus sama persis dengan path di host
# karena dipakai sekaligus sebagai volume mount path.
CHAT_DEFAULT_CWD=/opt/rnd-task-board
