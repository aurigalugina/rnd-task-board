PORT=8090

# Path (comma-separated) yang ditolak sebagai cwd sesi chat, DI LUAR home
# directory & root filesystem (dua itu selalu ditolak, lihat lib/cwdValidation.ts).
CWD_FORBIDDEN_ROOTS=

# Root default buat GET /fs/browse kalau ?path= tidak diisi. Default: $HOME.
BROWSE_DEFAULT_ROOT=

# Lokasi file penyimpanan token OAuth hasil /auth/setup-token.
TOKEN_STORE_PATH=./data/claude-oauth-token.json

# JANGAN diisi manual biasanya — di-set otomatis oleh POST /auth/setup-token
# (auth/tokenStore.ts) dan disimpan ke TOKEN_STORE_PATH, di-load lagi tiap
# service start. Isi di sini cuma buat override manual/testing.
# CLAUDE_CODE_OAUTH_TOKEN=
